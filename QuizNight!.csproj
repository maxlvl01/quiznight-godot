<Project Sdk="Godot.NET.Sdk/4.7.2">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <RootNamespace>QuizNight</RootNamespace>
    <Nullable>enable</Nullable>
    <LangVersion>12</LangVersion>
  </PropertyGroup>
  <!-- Exported games: unused parts of the .NET libraries are left out (partial: only libraries marked trimmable, so our
       code, GodotSharp and Facepunch stay whole). -->
  <PropertyGroup Condition="'$(Configuration)' == 'ExportRelease'">
    <PublishTrimmed>true</PublishTrimmed>
    <TrimMode>partial</TrimMode>
    <SuppressTrimAnalysisWarnings>true</SuppressTrimAnalysisWarnings>
    <!-- (Godot starts .NET from its own native host: trimming would switch that off) -->
    <_EnableConsumingManagedCodeFromNativeHosting>true</_EnableConsumingManagedCodeFromNativeHosting>
    <!-- (messages and saved files go through System.Text.Json by reflection over our types, which stay whole) -->
    <JsonSerializerIsReflectionEnabledByDefault>true</JsonSerializerIsReflectionEnabledByDefault>
  </PropertyGroup>
  <!-- Steam lobbies (room codes) and Steam relay networking. Runs under the Spacewar test app (480). -->
  <ItemGroup Condition="'$(GodotTargetPlatform)' != 'linuxbsd'">
    <PackageReference Include="Facepunch.Steamworks" Version="2.3.3" />
    <!-- The native Steam library has to sit next to the game's assemblies. -->
    <None Include="steam_api64.dll" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <!-- Linux builds: Facepunch's Posix build and Steam's Linux library (from the Facepunch 2.3.2 release
       on GitHub; the NuGet package only has Windows). lib/ has a .gdignore so Godot leaves it alone. -->
  <ItemGroup Condition="'$(GodotTargetPlatform)' == 'linuxbsd'">
    <Reference Include="Facepunch.Steamworks.Posix" HintPath="lib/linux64/Facepunch.Steamworks.Posix.dll" />
    <None Include="lib/linux64/libsteam_api.so" Link="libsteam_api.so" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
